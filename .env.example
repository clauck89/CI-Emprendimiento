# Configuración de entorno para VeredaCode (Docker Compose)
# Copia este archivo como .env y ajusta las credenciales en producción.

APP_PORT=8080

# Base de datos MySQL 8.0
MYSQL_DATABASE=veredacode_db
MYSQL_USER=veredacode_user
MYSQL_PASSWORD=veredacode_pass_seguro
MYSQL_ROOT_PASSWORD=root_pass_seguro

# WordPress Headless
WORDPRESS_DEBUG=0
